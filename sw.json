/* Ofertas GV — service worker (cache básico dos arquivos do app) */
var CACHE = 'ofertas-gv-v1';
var ASSETS = [
  './',
  './index.html',
  './ofertas.html',
  './styles.css',
  './app.js',
  './config.js',
  './manifest.json',
  './assets/icon.svg'
];

self.addEventListener('install', function (evento) {
  evento.waitUntil(
    caches.open(CACHE)
      .then(function (cache) { return cache.addAll(ASSETS); })
      .then(function () { return self.skipWaiting(); })
  );
});

self.addEventListener('activate', function (evento) {
  evento.waitUntil(
    caches.keys().then(function (chaves) {
      return Promise.all(chaves.filter(function (k) { return k !== CACHE; }).map(function (k) { return caches.delete(k); }));
    }).then(function () { return self.clients.claim(); })
  );
});

self.addEventListener('fetch', function (evento) {
  var url = new URL(evento.request.url);
  // Dados de ofertas sempre vêm da rede (frescos).
  if (url.search.indexOf('api=') >= 0 || url.pathname.indexOf('/exec') >= 0) return;
  evento.respondWith(
    caches.match(evento.request).then(function (resp) {
      return resp || fetch(evento.request).then(function (nova) {
        if (evento.request.method === 'GET' && nova.ok) {
          var copia = nova.clone();
          caches.open(CACHE).then(function (cache) { cache.put(evento.request, copia); });
        }
        return nova;
      });
    }).catch(function () {
      if (evento.request.mode === 'navigate') return caches.match('./index.html');
    })
  );
});